# Pi-Board configuration

PIBOARD_HOST=0.0.0.0
PIBOARD_PORT=5000

# Where posters are stored (uploaded + served)
PIBOARD_POSTERS_DIR=./posters

# Display backend: feh (desktop) | fbi (framebuffer) | dummy (no-op)
PIBOARD_DISPLAY_BACKEND=feh

# Default delay per image in slideshow
PIBOARD_SLIDESHOW_DELAY_SECONDS=10
