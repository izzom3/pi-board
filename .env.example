# Pi-Board configuration

PIBOARD_HOST=0.0.0.0
PIBOARD_PORT=5000

# Where posters are stored (uploaded + served)
PIBOARD_POSTERS_DIR=./posters

# Display backend: feh (desktop) | fbi (framebuffer) | dummy (no-op)
PIBOARD_DISPLAY_BACKEND=feh

# Default delay per image in slideshow
PIBOARD_SLIDESHOW_DELAY_SECONDS=10

# Rotate posters before displaying (clockwise degrees). Useful when the monitor is physically rotated.
PIBOARD_ROTATE_DEGREES_CLOCKWISE=90

# How to fit to the screen:
# - stretch: fill the display completely (may distort aspect ratio)
# - cover: fill the display by cropping (keeps aspect ratio)
# - contain: keep aspect ratio with letterboxing
PIBOARD_FIT_MODE=stretch

# Optional: override detected screen size.
# PIBOARD_SCREEN_WIDTH=1080
# PIBOARD_SCREEN_HEIGHT=1620
